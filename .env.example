# Never commit real values.
XRP_ENGINE_MODE=demo
XRP_ENGINE_DB_PATH=state/live/engine.sqlite3
XRP_ENGINE_LOG_LEVEL=INFO

# Public market-data adapters can work without keys where provider policy permits.
BINANCE_BASE_URL=https://data-api.binance.vision
COINBASE_BASE_URL=https://api.exchange.coinbase.com
KRAKEN_BASE_URL=https://api.kraken.com
XRPL_JSON_RPC_URL=https://s1.ripple.com:51234

# Macro provider
FRED_API_KEY=

# Optional paid/secondary vendors
POLYGON_API_KEY=
TWELVEDATA_API_KEY=
COINGLASS_API_KEY=
GLASSNODE_API_KEY=

# Optional outbound alerts
ALERT_WEBHOOK_URL=

{
  "$defs": {
    "DataFlag": {
      "enum": [
        "STALE",
        "OUTLIER",
        "CONFLICT",
        "MISSING",
        "SYNTHETIC",
        "REVISED",
        "INVALID"
      ],
      "title": "DataFlag",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/DataFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "payload_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Hash"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        }
      },
      "required": [
        "provider",
        "observed_at",
        "available_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://rotprods.local/schemas/market_observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset": {
      "minLength": 1,
      "title": "Asset",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "metric": {
      "minLength": 1,
      "title": "Metric",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "unit": {
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "title": "Value",
      "type": "number"
    }
  },
  "required": [
    "asset",
    "metric",
    "value",
    "unit",
    "observed_at",
    "available_at",
    "provenance"
  ],
  "title": "AssetObservation",
  "type": "object"
}

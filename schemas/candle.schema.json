{
  "$defs": {
    "DataFlag": {
      "enum": [
        "STALE",
        "OUTLIER",
        "CONFLICT",
        "MISSING",
        "SYNTHETIC",
        "REVISED",
        "INVALID"
      ],
      "title": "DataFlag",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/DataFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "payload_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Hash"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        }
      },
      "required": [
        "provider",
        "observed_at",
        "available_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://rotprods.local/schemas/candle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset": {
      "minLength": 1,
      "title": "Asset",
      "type": "string"
    },
    "close": {
      "title": "Close",
      "type": "number"
    },
    "close_time": {
      "format": "date-time",
      "title": "Close Time",
      "type": "string"
    },
    "high": {
      "title": "High",
      "type": "number"
    },
    "interval": {
      "minLength": 1,
      "title": "Interval",
      "type": "string"
    },
    "low": {
      "title": "Low",
      "type": "number"
    },
    "open": {
      "title": "Open",
      "type": "number"
    },
    "open_time": {
      "format": "date-time",
      "title": "Open Time",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "volume": {
      "default": 0.0,
      "title": "Volume",
      "type": "number"
    }
  },
  "required": [
    "asset",
    "interval",
    "open_time",
    "close_time",
    "open",
    "high",
    "low",
    "close",
    "provenance"
  ],
  "title": "Candle",
  "type": "object"
}

{
  "version": "0.5.0",
  "storage": {
    "raw": "content-addressed immutable bytes",
    "normalized": "deterministic JSONL partitions",
    "catalog": "SQLite point-in-time index",
    "manifests": "SHA-256 immutable manifests",
    "recommended_scale_target": "Parquet + DuckDB/Polars after schema validation"
  },
  "datasets": [
    {
      "id": "xrp_usd_spot_3600s",
      "provider": "coinbase",
      "base_asset": "XRP",
      "quote_asset": "USD",
      "interval_seconds": 3600,
      "schema_version": "candle.v1",
      "adapter": "CoinbaseCandleAdapter",
      "availability_policy": "candle_close",
      "revision_policy": "provider_replay_creates_new revision only when content changes"
    },
    {
      "id": "xrp_usdt_spot_3600s",
      "provider": "binance",
      "base_asset": "XRP",
      "quote_asset": "USDT",
      "interval_seconds": 3600,
      "schema_version": "candle.v1",
      "adapter": "BinanceKlineAdapter",
      "availability_policy": "close_time_plus_one_millisecond",
      "quality_flags": ["STABLECOIN_QUOTE", "REGIONAL_AVAILABILITY_REQUIRED"]
    }
  ],
  "research_windows": [
